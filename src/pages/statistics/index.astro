---
import Base from '../../layouts/Base.astro';
import '../../styles/stats.css';
import { injuries, garages, STATS_UPDATED_LABEL, SITE_URL, SITE_NAME, round100 } from '../../lib/stats';
const pages = [
  { href: '/statistics/garage-door-injuries/', title: 'Garage door injury statistics', blurb: `About ${round100(injuries.total.est / 10)} ER visits a year for garage door injuries in the US. Fingers, crush injuries, children and openers.` },
  { href: '/statistics/garages/', title: 'US garage statistics', blurb: `${garages.all.pct}% of US homes have an attached garage. By state, size, home age and EV ownership.` },
];
---
<Base title="Garage and Garage Door Statistics" description="Original statistics on US garages and garage door injuries, from our analysis of federal survey and hospital injury data." jsonLd={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${SITE_NAME} statistics`, url: `${SITE_URL}/statistics/` }}>
  <section class="st-section">
    <p class="crumbs"><a href="/">Home</a> › Statistics</p>
    <h1>Garage and garage door statistics</h1>
    <p class="updated">Updated {STATS_UPDATED_LABEL}</p>
    <p class="lede">Original research from {SITE_NAME}, from our own analysis of federal hospital injury records and household survey microdata. Every figure has its own link, sources and methodology, and you're welcome to cite them with a link back.</p>
  </section>
  <section class="st-section"><ul class="kstats">{pages.map((p) => (<li class="kstat"><h2><a href={p.href}>{p.title}</a></h2><p class="kstat-text">{p.blurb}</p></li>))}</ul></section>
  <section class="st-section"><h2>Downloads</h2><ul class="st-links" style="grid-template-columns:1fr"><li><a href="/data/garage-door-injuries-by-year.csv" download>Garage door injuries by year (CSV)</a></li><li><a href="/data/attached-garages-by-state.csv" download>Attached garages by state (CSV)</a></li></ul><p class="st-small st-muted">Free to reuse under CC BY 4.0: please credit {SITE_NAME} with a link.</p></section>
</Base>
